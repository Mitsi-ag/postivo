# Postgres connection (required). Local default matches docker-compose.yml.
DATABASE_URL=postgres://postivo:postivo@localhost:5432/postivo
# Set to true for managed Postgres that needs SSL with a self-signed chain (e.g. RDS).
# DATABASE_SSL=false

# Secret used to sign session tokens. REQUIRED in multi-instance deployments so
# every replica can verify sessions. If unset, a random secret is generated and
# persisted to ${DATA_DIR}/jwt_secret (single-process dev only).
# JWT_SECRET=change-me-to-a-long-random-string

# 32-byte hex key that encrypts channel credentials at rest (AES-256-GCM).
# If unset, a key is derived from JWT_SECRET — fine for dev, but set this in
# production so credential access is independent of session signing.
# CREDENTIALS_KEY=

# Media storage. With S3_BUCKET unset, uploads are stored on local disk under
# ${DATA_DIR}/uploads (dev mode, single instance only).
# S3_BUCKET=postivo-uploads
# AWS_REGION=us-east-1
# (plus standard AWS credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or IAM role)

# Stripe billing (optional — billing routes return 503 without these and the UI
# hides upgrade buttons).
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Public base URL of the app, used for Stripe success/cancel/return URLs and
# as the base of links in transactional emails (reset / verify).
# APP_URL=http://localhost:3000

# Transactional email via Amazon SES v2 (hand-rolled SigV4 — no extra deps).
# Off by default: with EMAIL_ENABLED unset, mail functions log
# "[mail] would send: <subject>" and succeed, so auth flows are identical in dev.
# EMAIL_ENABLED=true
# EMAIL_FROM="Postivo <hello@postivo.keenshift.ai>"
# SES region: AWS_REGION (or AWS_DEFAULT_REGION), default ap-southeast-2.
# Credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (+ AWS_SESSION_TOKEN)
# for local dev, or automatically from the ECS / App Runner container
# credentials endpoint (AWS_CONTAINER_CREDENTIALS_RELATIVE_URI) in production.

# Test-only hook (NEVER in production): with NODE_ENV != production, exposes
# raw reset/verify tokens in x-test-reset-token / x-test-verify-token response
# headers so the Playwright suite can complete token flows without an inbox.
# E2E_TOKENS=1

# Optional: enable real AI caption suggestions (OpenAI-compatible API).
# Without these, /api/ai/caption uses a smart local fallback (Pro plan only).
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Where local-disk uploads (dev mode) and the generated jwt_secret live.
# DATA_DIR=./data

# SSRF guard: user-supplied URLs (webhook provider, RSS feeds, media import,
# outbound webhook) may never resolve to private/loopback addresses. This
# comma-separated hostname allowlist bypasses the guard — for local dev/test
# rigs only. NEVER set in production.
# SSRF_ALLOW_HOSTS=localhost,127.0.0.1

# Port for `next dev` / `next start`
# PORT=3000
